<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">    
    <link rel="stylesheet" href="css/styles.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>    
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <script src="js/source.js"></script>

</head>

<body>   
    <header class="header">
        <h1>Admin Dashboard</h1>
        <div class="user-info">Welcome, <span id="username"><!--UTRGV Vaqueros-->UTRGV Vaqueros</span></div>
    </header>

    <div class="dashboard">
        
        <aside class="sidebar"> <!-- LEFT COLUMN: Menu with buttons -->
            <button class="nav-button" data-section="dashboard">
                Dashboard
            </button>
            <button class="nav-button" data-section="customers">
                Customers
            </button>
            <button class="nav-button" data-section="reports">
                Reports
            </button>
            <button id="newCustomerButton">
                + New Customer
            </button>
        </aside>
        
        <main class="content">  <!-- MAIN AREA: Dashboard with stats and sections -->      
            
            <section class="stats">
                <div class="card" id="card-revenue">
                    <div class="stat-title">Revenue</div>
                    <div class="stat-value green"><span class="revenue-amt"><!--$48,250--><%= money(revenue) %></span></div>
                </div>
                <div class="card" id="card-customers">
                    <div class="stat-title">Customers</div>
                    <div class="stat-value blue"><span id="customer-num"><!--1,284--><%= totalCustomers.toLocaleString("en-US") %></span></div>
                </div>
                <div class="card" id="card-orders">
                    <div class="stat-title">Orders</div>
                    <div class="stat-value orange"><span id="orders-amt"><!--342--><%= orderCount %></span></div>
                </div>
                <div class="card" id="card-issues">
                    <div class="stat-title">Issues</div>
                    <div class="stat-value red"><span id="issues-amt"><!--12--><%= issueCount %></span></div>
                </div>
            </section>


            <div class="dashboard-grid">
                <div>
                    <section class="panel">
                        <div id="dashboardTabs">
                            <ul>
                                <li><a href="#tab-overview">Overview</a></li>
                                <li><a href="#tab-sales">Sales</a></li>
                            </ul>

                            <div id="tab-overview">
                                <h3>Monthly Performance</h3>
                                <p>Revenue is currently at <strong class="revenue-amt"> <!--$48,250--><%= money(revenue) %></strong></p>
                            </div>

                            <div id="tab-sales">
                                <h3>Sales Summary</h3>
                                <table id="salesTable">
                                    <thead>
                                        <tr>
                                            <th>Product</th>
                                            <th>Sales</th>
                                            <th>Revenue</th>
                                        </tr>
                                    </thead>

                                    <tbody id="salesTableBody">
                                        <!-- <tr>
                                            <td>Product A</td>
                                            <td>124</td>
                                            <td>$12,400</td>
                                        </tr>

                                        <tr>
                                            <td>Product B</td>
                                            <td>98</td>
                                            <td>$9,800</td>
                                        </tr>

                                        <tr>
                                            <td>Product C</td>
                                            <td>75</td>
                                            <td>$7,500</td>
                                        </tr> -->
                                    
<% sales.forEach(sale => { %>
<tr><td><%= sale.name || 'Unknown product' %></td><td><%= sale.quantity %></td><td><%= money(sale.saleamount) %></td></tr>
<% }); %>
<% if (!sales.length) { %><tr><td colspan="3">No sales found.</td></tr><% } %>
</tbody>
                                </table>
                            </div>

                        </div>

                    </section>

                    
                    <section class="panel">
                        <h2>Recent Customers</h2>
                        <table id="customerTable">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Status</th>
                                    <th>Joined</th>
                                </tr>
                            </thead>

                            <tbody id="customerTableBody">
                                <!-- <tr>
                                    <td>Alice Johnson</td>
                                    <td>alice@example.com</td>
                                    <td><span class="status status-active">Active</span></td>
                                    <td>09/10/2026</td>
                                </tr>
                                <tr>
                                    <td>Robert Smith</td>
                                    <td>robert@example.com</td>
                                    <td><span class="status status-pending">Pending</span></td>
                                    <td>09/12/2026</td>
                                </tr>

                                <tr>
                                    <td>Maria Garcia</td>
                                    <td>maria@example.com</td>
                                    <td><span class="status status-active">Active</span></td>
                                    <td>09/15/2026</td>
                                </tr> -->
                            
<% customers.forEach(customer => { %>
<tr><td><%= customer.name %></td><td><%= customer.email %></td>
<td><span class="status <%= customer.status === 'active' ? 'status-active' : 'status-pending' %>"><%= customer.status %></span></td>
<td><%= formatDate(customer.datejoined) %></td></tr>
<% }); %>
<% if (!customers.length) { %><tr><td colspan="4">No customers found.</td></tr><% } %>
</tbody>
                        </table>
                        <div class="pagination">
                            <% if (currentPage > 1) { %>
                                <a href="/?page=<%= currentPage - 1 %>">Previous</a>
                            <% } %>
                            <span>Page <%= currentPage %> of <%= totalPages %></span>
                            <% if (currentPage < totalPages) { %>
                                <a href="/?page=<%= currentPage + 1 %>">Next</a>
                            <% } %>
                        </div>
                        
                    </section>
                </div>


                <div>
                    <section class="panel">
                        <div id="accordion">
                            <h3>Issues</h3>
                            <div>
                                <div class="green">
                                    <ul id="system-status-list">
                                        <!-- <li>All systems operational</li>
                                        <li>All settings loaded for this system</li>                                         -->
                                    <% issues.forEach(alert => { %><li><%= alert.description %></li><% }); %><% if (!issues.length) { %><li>None.</li><% } %></ul>
                                </div>
                            </div>

                            <h3>Notifications</h3>
                            <div>
                                <p>You have <span id="notification-num"><!-- 3--><%= notificationCount %></span> new notifications.</p>
                                <ol id="notifications-list">
                                    <!-- <li>A new shipment is expected to arrive on Sep 30, 2026</li>
                                    <li>There are 12 outstanding issues with last week's orders </li>
                                    <li>Three new customers joined our platform in the last month</li> -->
                                <% notifications.forEach(alert => { %><li><%= alert.description %></li><% }); %><% if (!notifications.length) { %><li>None.</li><% } %></ol>
                            </div>

                            <h3>Tasks</h3>
                            <div>
                                <ul id="tasks-list">
                                    <!-- <li>Review orders</li>
                                    <li>Contact customer</li>
                                    <li>Generate report</li> -->
                                <% tasks.forEach(alert => { %><li><%= alert.description %></li><% }); %><% if (!tasks.length) { %><li>None.</li><% } %></ul>
                            </div>

                        </div>
                    </section>

                    <section class="panel">
                        <h2>Under construction...</h2>
                    </section>
                    
                    <section class="panel">
                        <h2>Under construction...</h2>
                    </section>

                </div>

            </div>

        </main>

    </div>


    <!-- TODO: Make it a jQuery Dialog -->
    <div id="customerDialog" title="Create New Customer" style="display: none;">
        <div class="form-row">
            <label for="customerName">Name</label>
            <input type="text" id="customerName">
        </div>

        <div class="form-row">
            <label for="customerEmail">Email</label>
            <input type="email" id="customerEmail">
        </div>


        <div class="form-row">
            <label for="customerType">Customer Type</label>
            <select id="customerType">
                <option>Standard</option>
                <option>Premium</option>
                <option>Enterprise</option>
            </select>
        </div>

        <div class="form-row">
            <label for="customerDate">Registration Date</label>
            <input type="text" id="customerDate">
        </div>
    </div>


   

</body>
</html>
